/storage/app/livewire-tmp/

# Кэш Filament при оптимизации
/bootstrap/cache/filament/
/bootstrap/cache/packages.php
/bootstrap/cache/services.php

# Сгенерированные файлы Filament
/app/Filament/Resources/*/Pages/*.php
!/app/Filament/Resources/*/Pages/*.php
!app/Filament/Resources/*/Pages/**/*.php

# Логи Filament
/storage/logs/filament/

